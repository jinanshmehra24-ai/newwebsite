{
  "name": "chandra-and-co",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "//": "Scripts call binaries through node directly: the '&' in this folder's path breaks npm's Windows .cmd shims.",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./scripts/sitemap.mjs && node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b",
    "sitemap": "node ./scripts/sitemap.mjs",
    "icons": "node ./scripts/icons.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
